# --- Database ---
# Local (Homebrew Postgres, your macOS user as role):
#   POSTGRES_URL="postgres://YOUR_MAC_USER@localhost:5432/leworldcup"
# Local (Docker postgres image):
#   POSTGRES_URL="postgres://postgres:postgres@localhost:5432/leworldcup"
# Vercel: injected automatically by the Vercel Postgres integration.
POSTGRES_URL="postgres://eddielong@localhost:5432/leworldcup"

# --- Auth ---
# 32+ random bytes, base64. Generate: openssl rand -base64 48
AUTH_SECRET="replace-me-with-openssl-rand-base64-48"

# Single shared invite code for friends. Rotate any time; old cookies stay valid.
INVITE_CODE="goal-2026"

# Admin password (separate flow at /admin). scrypt hash, not plaintext.
# Generate: pnpm admin:hash 'your-admin-pw'
ADMIN_PASSWORD_HASH="scrypt$16384$replace-with-output-of-admin:hash"

# --- Cron ---
# Random token. Vercel Cron must send Authorization: Bearer $CRON_SECRET.
CRON_SECRET="replace-me-with-openssl-rand-hex-32"

# --- Football data ---
# Free tier from https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=""

# --- Email (optional, for password reset) ---
# Sign up at https://resend.com (free tier: 3000/month). If unset, the
# "forgot password" flow is disabled gracefully and admin resets manually.
RESEND_API_KEY=""
# Sender address. Use onboarding@resend.dev for sandbox (zero DNS), or set up
# a verified sending domain in Resend and use noreply@yourdomain.com.
RESET_FROM_EMAIL="onboarding@resend.dev"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
